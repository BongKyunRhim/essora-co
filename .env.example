# Copy this file to .env for local development (never commit .env).
# For local testing, use TEST-mode keys (sk_test_... / whsec_... from `stripe listen`).
# In Vercel, set the same three variables in Project Settings → Environment Variables.

# Stripe secret key — sk_test_... for test mode, sk_live_... for live mode
STRIPE_SECRET_KEY=sk_test_xxx

# Webhook signing secret — from `stripe listen` locally, or the webhook
# endpoint's signing secret in the Stripe dashboard for deployed environments
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Supabase service role key — Supabase dashboard → Project Settings → API
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# Optional: Resend API key for reviewer notification emails (resend.com).
# If unset, emails are skipped and everything else works normally.
RESEND_API_KEY=re_xxx

# Optional: the From address for notification emails. Must be on a domain
# verified in Resend. Defaults to Resend's onboarding sender (testing only —
# it can only email your own Resend account address).
EMAIL_FROM="ESSORA <notifications@essora.co>"

# Required for the 3-day review deadline cron (api/expire-reviews.js).
# Any long random string; Vercel automatically sends it as the Authorization
# header when invoking cron jobs. Generate one at https://generate-secret.vercel.app/32
CRON_SECRET=xxx
